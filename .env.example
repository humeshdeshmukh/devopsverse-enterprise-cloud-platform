# Database Setup
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespass
POSTGRES_DB=devopsverse

# Cache Setup
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Setup
PORT=3001
NODE_ENV=development

# AI SRE Config (OpenAI and Gemini supported)
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=openai # Options: openai, gemini, mock

# Platform Config
ARGO_CD_URL=https://argocd.devopsverse.local
BACKSTAGE_URL=https://catalog.devopsverse.local
KONG_ADMIN_URL=http://kong:8001
